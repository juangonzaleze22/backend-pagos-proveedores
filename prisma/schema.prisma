generator client {
  provider      = "prisma-client-js"
  // Incluir Linux explícito: en Hostinger/cPanel el motor debe coincidir con OpenSSL del servidor.
  // Si generas en Windows y subes node_modules, sin esto suele fallar o aparecer PANIC en runtime.
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Rol {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  usuarios  Usuario[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Usuario {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  password       String
  nombre         String
  rolId          Int
  rol            Rol       @relation(fields: [rolId], references: [id])
  orders         Order[]   @relation("OrderCreator")
  payments       Payment[] @relation("PaymentCreator")
  deletedPayments Payment[] @relation("PaymentDeleter")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

enum SupplierStatus {
  PENDING
  COMPLETED
}

enum DebtStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  ZELLE
  TRANSFER
  PAGO_MOVIL
  CASH
}

model Supplier {
  id              Int       @id @default(autoincrement())
  companyName     String
  taxId           String?   @unique
  email           String?
  phone           String?
  status          SupplierStatus @default(PENDING)
  totalDebt       Decimal   @default(0) @db.Decimal(10, 2)
  lastPaymentDate DateTime?
  orders          Order[]
  debts           Debt[]
  payments        Payment[]
  credits         Credit[]
  paymentAccounts SupplierPaymentAccount[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum SupplierPaymentMethodType {
  PAGO_MOVIL
  ZELLE
  TRANSFER
}

/// Cuentas/datos de pago que el distribuidor usa para recibir pagos.
/// Ej.: Pago Móvil (banco, teléfono, cédula), Zelle (email/ID) o Transferencia (banco, cuenta).
model SupplierPaymentAccount {
  id            Int                       @id @default(autoincrement())
  supplierId    Int
  supplier      Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type          SupplierPaymentMethodType
  bank          String?
  accountNumber String?
  holderName    String?
  holderId      String?
  email         String?
  phone         String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([supplierId])
}

model Order {
  id           Int      @id @default(autoincrement())
  supplierId   Int
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount       Decimal  @db.Decimal(10, 2)
  dispatchDate DateTime
  creditDays   Int
  dueDate      DateTime
  createdBy    Int
  createdByUser Usuario @relation("OrderCreator", fields: [createdBy], references: [id])
  invoiceFiles Json?    // array de nombres de archivo de facturas (máx. 2)
  debt         Debt?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Debt {
  id                    Int          @id @default(autoincrement())
  orderId               Int          @unique
  order                 Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierId            Int
  supplier              Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  title                 String?
  initialAmount         Decimal      @db.Decimal(10, 2)
  remainingAmount       Decimal     @db.Decimal(10, 2)
  surplusAmountAtCreation Decimal?   @db.Decimal(10, 2) // Saldo excedente aplicado al crear la deuda (desde créditos del proveedor)
  status                DebtStatus   @default(PENDING)
  dueDate               DateTime
  payments              Payment[]
  creditsOriginated     Credit[] @relation("OriginDebt")
  paymentsSurplusTarget Payment[]    @relation("SurplusTargetDebt")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model Payment {
  id                Int           @id @default(autoincrement())
  debtId            Int
  debt              Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  supplierId        Int
  supplier          Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount            Decimal       @db.Decimal(10, 2)
  paymentMethod     PaymentMethod
  senderName        String
  senderEmail       String?
  confirmationNumber String?
  paymentDate       DateTime
  nota              String?
  receiptFile       String?       // legacy: una sola imagen (mantener por compatibilidad)
  receiptFiles      Json?        // array de nombres de archivo para múltiples imágenes
  /// Copia de los datos de la cuenta del proveedor usada para este pago.
  /// Se guarda como snapshot para conservar el historial aunque la cuenta se edite/elimine.
  destinationAccountSnapshot Json?
  verified          Boolean       @default(false)
  shared            Boolean       @default(false)
  sharedAt         DateTime?
  exchangeRate      Decimal?      @db.Decimal(10, 4)
  amountInBolivares Decimal?      @db.Decimal(10, 2)
  surplusAmount     Decimal?      @db.Decimal(10, 2)
  surplusTargetDebtId  Int?
  surplusAppliedToDebt Decimal?   @db.Decimal(10, 2)
  surplusTargetDebt    Debt?       @relation("SurplusTargetDebt", fields: [surplusTargetDebtId], references: [id])
  createdBy         Int
  createdByUser     Usuario       @relation("PaymentCreator", fields: [createdBy], references: [id])
  deletedAt         DateTime?
  deletedBy         Int?
  deletedByUser     Usuario?      @relation("PaymentDeleter", fields: [deletedBy], references: [id])
  deletionReason    String?
  credits           Credit[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Credit {
  id           Int      @id @default(autoincrement())
  paymentId    Int
  originDebtId Int
  supplierId   Int
  amount       Decimal  @db.Decimal(12, 2)
  remaining    Decimal  @db.Decimal(12, 2)
  status       String   @default("AVAILABLE")
  description  String?
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  originDebt   Debt     @relation("OriginDebt", fields: [originDebtId], references: [id])
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Configuración visual de marca (fila única). Permite personalizar el sistema
/// por cliente sin recompilar: colores, logos, favicon y textos.
model BrandingConfig {
  id             Int      @id @default(autoincrement())
  appName        String   @default("Gestión de Pagos")
  companyName    String   @default("Mi Empresa")
  loginTitle     String   @default("Gestión de Pagos")
  loginSubtitle  String   @default("Bienvenido al portal corporativo")
  footerText     String?
  reportTitle    String   @default("Reporte de Pagos a Proveedor")
  logoPath       String?
  faviconPath    String?
  primaryColor   String   @default("#3b82f6")
  accentColor    String   @default("#2563eb")
  updatedBy      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

